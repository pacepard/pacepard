{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true

    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "dist/**"]
    },
    "lint": {},
    "check-types": {
      "dependsOn": ["^check-types"],
      "outputs": []
    },
    "@pacepard/api-docs#build": {
      "dependsOn": [],
      "cache": false,
      "outputs": []
    }
  }
}
