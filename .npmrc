strict-peer-dependencies=false
# TipTap Pro: use the NPM token from Cloud > My features > Pro Extensions (not the generic API key).
# https://cloud.tiptap.dev/v2/features/pro-extensions — Content AI and some extensions need an active Pro plan.
@tiptap-pro:registry=https://registry.tiptap.dev/
//registry.tiptap.dev/:_authToken=${TIPTAP_PRO_TOKEN}
//registry.tiptap.dev/:always-auth=true
