extends ../../base-email

block content
  tr
    td(style="padding: 40px 40px 32px;")
      // Heading
      h1(style="margin: 0 0 24px; font-size: 24px; font-weight: 400; line-height: 32px; color: #202124; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;") Verify your account
      
      // Greeting
      p(style="margin: 0 0 16px; font-size: 14px; line-height: 20px; color: #202124; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;")
        | Hi 
        span(style="font-weight: 500;")= name
        | ,
      
      // Main message
      p(style="margin: 0 0 24px; font-size: 14px; line-height: 20px; color: #5F6368; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;")
        | Use the verification code below to complete your account verification:
      
      // OTP Code
      table(cellpadding="0" cellspacing="0" style="margin: 24px 0;")
        tr
          td(style="padding: 20px; background-color: #F8F9FA; border: 1px solid #E8EAED; border-radius: 4px;")
            p(style="margin: 0 0 8px; font-size: 14px; font-weight: 500; color: #5F6368; text-transform: uppercase; letter-spacing: 0.5px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;") Verification Code
            p(style="margin: 0; font-size: 32px; font-weight: 500; color: #202124; letter-spacing: 4px; font-family: 'Courier New', Courier, monospace;")= code
            p(style="margin: 12px 0 0; font-size: 14px; line-height: 20px; color: #5F6368; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;")
              | Expires in 
              span(style="font-weight: 500; color: #202124;")= expiry
      
      // Instructions
      p(style="margin: 24px 0 0; font-size: 14px; line-height: 20px; color: #5F6368; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;")
        | Copy this code and paste it into the verification page when prompted.
      
      // Security notice
      p(style="margin: 32px 0 0; padding-top: 24px; border-top: 1px solid #E8EAED; font-size: 14px; line-height: 20px; color: #5F6368; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;")
        | For your security, never share this code with anyone. Our team will never ask for your verification code.
      
      // Closing
      p(style="margin: 32px 0 0; font-size: 14px; line-height: 20px; color: #202124; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;")
        | Thanks,
        br
        span(style="font-weight: 500;") The Pacepard Team
