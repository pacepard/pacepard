# Git
.git
.gitignore
.gitattributes

# Documentation
*.md
docs/
.changeset/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Dependencies (will be installed in container)
node_modules/
.pnpm-store/

# Build outputs (will be built in container)
dist/
.next/
.turbo/
build/
out/

# Environment files (should be provided at runtime)
.env
.env.local
.env.*.local

# Test files
**/__tests__/
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
coverage/
.nyc_output/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.cache/
.temp/
tmp/

# CI/CD
.github/
.circleci/
.travis.yml
.gitlab-ci.yml

# Docker — root only. A bare `Dockerfile*` would also ignore `apps/api/Dockerfile` etc.,
# which can break BuildKit when COPYing those app trees.
/Dockerfile*
/docker-compose*.yml
/.dockerignore

# Linting
.eslintcache
.stylelintcache

# TypeScript
*.tsbuildinfo

# Turborepo
.turbo/

# One root .dockerignore applies to every image (api, web, main, service). Do not list
# apps/* or packages/* that any Dockerfile COPYs or that pnpm lockfile resolves.
tooling/
apps/demo
